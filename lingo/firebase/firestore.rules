rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function ok() { return request.auth != null; }
    function chat(c) { return get(/databases/$(db)/documents/chats/$(c)).data; }
    function mem(c) { return ok() && request.auth.uid in chat(c).members; }

    match /users/{u} {
      allow read: if ok();
      allow create: if ok() && request.auth.uid == u;
      allow update: if ok() && request.auth.uid == u && request.resource.data.username == resource.data.username;
    }
    // Usernames can be created once and never changed, so each one stays unique
    match /usernames/{n} {
      allow read: if ok();
      allow create: if ok() && request.resource.data.uid == request.auth.uid;
    }
    // Group invitations: only the group admin can invite, only the invited person can answer
    match /invites/{i} {
      allow get: if ok() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow list: if ok() && resource.data.to == request.auth.uid;
      allow create: if ok() && request.resource.data.from == request.auth.uid
        && i == request.resource.data.gid + '_' + request.resource.data.to
        && get(/databases/$(db)/documents/chats/$(request.resource.data.gid)).data.admin == request.auth.uid;
      allow delete: if ok() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
    }
    match /chats/{c} {
      allow get: if ok() && (resource == null || request.auth.uid in resource.data.members);
      allow list: if ok() && request.auth.uid in resource.data.members;
      allow create: if ok() && request.auth.uid in request.resource.data.members
        && request.resource.data.from == request.auth.uid
        && (request.resource.data.status == 'pending'
            || (request.resource.data.get('group', false) == true && request.resource.data.status == 'active'
                && request.resource.data.members.size() == 1 && request.resource.data.admin == request.auth.uid));
      allow update: if ok() && (
        // everyday updates by members (nothing about membership, admin or name)
        (request.auth.uid in resource.data.members
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['members', 'admin', 'group', 'name', 'from'])
          && (request.resource.data.status == resource.data.status || resource.data.from != request.auth.uid)
          && (request.resource.data.get('blocked', '') == resource.data.get('blocked', '')
              || resource.data.get('blocked', '') == '' && request.resource.data.get('blocked', '') == request.auth.uid
              || resource.data.get('blocked', '') == request.auth.uid))
        // accepting an invitation to a group
        || (resource.data.get('group', false) == true && !(request.auth.uid in resource.data.members)
            && exists(/databases/$(db)/documents/invites/$(c + '_' + request.auth.uid))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
            && request.resource.data.members.size() == resource.data.members.size() + 1
            && request.resource.data.members.hasAll(resource.data.members)
            && request.auth.uid in request.resource.data.members)
        // leaving a group, or the admin removing someone
        || (resource.data.get('group', false) == true && request.auth.uid in resource.data.members
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'admin'])
            && request.resource.data.members.size() == resource.data.members.size() - 1
            && resource.data.members.hasAll(request.resource.data.members)
            && (request.resource.data.get('admin', '') in request.resource.data.members || request.resource.data.members.size() == 0)
            && (resource.data.admin == request.auth.uid || !(request.auth.uid in request.resource.data.members)))
        // the admin renaming the group
        || (resource.data.get('group', false) == true && resource.data.admin == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']))
      );

      match /messages/{m} {
        allow read: if mem(c);
        allow create: if mem(c) && request.resource.data.from == request.auth.uid && chat(c).status == 'active' && chat(c).get('blocked', '') == '';
        // Readers may only add translations and reactions
        allow update: if mem(c) && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tr', 'src', 'rx'])
          // the author can edit their own message
          || (resource.data.from == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited', 'lang', 'tr', 'src', 'rx'])));
        allow delete: if mem(c) && resource.data.from == request.auth.uid;
      }
      match /photos/{p} {
        allow read: if mem(c);
        allow create: if mem(c) && request.resource.data.from == request.auth.uid;
        allow delete: if mem(c) && resource.data.from == request.auth.uid;
      }
    }
  }
}
